#!/bin/bash
# cx_proxy - 切换 Codex 走本地容量重试代理（自动重试 "Selected model is at capacity"），
# 并确保代理服务已启用、在运行。provider ID 保持不变，只切换 base_url。
set -euo pipefail
CONFIG="$HOME/.codex/config.toml"
PLIST="$HOME/Library/LaunchAgents/com.codex.capacity-retry-proxy.plist"
SERVICE="gui/$(id -u)/com.codex.capacity-retry-proxy"
PORT="$(cat "$HOME/.codex/capacity-retry-proxy/port" 2>/dev/null || echo 8317)"

python3 - "$CONFIG" "$PORT" <<'EOF'
import sys, pathlib, re
config_path, port = sys.argv[1], sys.argv[2]
p = pathlib.Path(config_path)
s = p.read_text()
provider_id = "openai-proxy"
base_url = f"http://127.0.0.1:{port}/backend-api/codex"

# Keep the provider identity stable. Codex persists this ID in each session and
# uses it when resolving named sessions during resume.
s = re.sub(r'(?m)^\s*#?\s*model_provider\s*=\s*"[^"\n]+"\s*\n', '', s)
s = f'model_provider = "{provider_id}"\n\n' + s.lstrip('\n')

section_re = re.compile(r'(?ms)^\[model_providers\.openai-proxy\]\n.*?(?=^\[|\Z)')
match = section_re.search(s)
if match:
    section = match.group(0)
    section = re.sub(r'(?m)^\s*base_url\s*=\s*"[^"\n]*"\s*\n',
                     f'base_url = "{base_url}"\n', section, count=1)
    if 'base_url =' not in section:
        section = section.replace('[model_providers.openai-proxy]\n',
                                  f'[model_providers.openai-proxy]\nbase_url = "{base_url}"\n', 1)
    if re.search(r'(?m)^\s*supports_websockets\s*=', section):
        section = re.sub(r'(?m)^\s*supports_websockets\s*=\s*[^\n]*\n',
                         'supports_websockets = false\n', section, count=1)
    else:
        section = section.rstrip('\n') + '\nsupports_websockets = false\n'
    s = s[:match.start()] + section + s[match.end():]
else:
    s = s.rstrip('\n') + f'''

[model_providers.openai-proxy]
name = "OpenAI (capacity-retry route)"
base_url = "{base_url}"
wire_api = "responses"
requires_openai_auth = true
supports_websockets = false
'''
p.write_text(s)
EOF

# 恢复代理服务：enable 解除 cx_office 的停用，bootstrap (重新)加载并启动。
# 已在运行时 bootstrap 会报错，属正常情况，先 bootout 再 bootstrap 保证幂等。
# SKIP_LAUNCHCTL=1 时跳过（供 install.sh 的 SKIP_LAUNCHD 沙箱安装使用）。
if [ "${SKIP_LAUNCHCTL:-0}" != "1" ]; then
  if [ -f "$PLIST" ]; then
    launchctl enable "$SERVICE" 2>/dev/null || true
    launchctl bootout "$SERVICE" 2>/dev/null || true
    launchctl bootstrap "gui/$(id -u)" "$PLIST" 2>/dev/null || true
  else
    echo "⚠️  缺少 ${PLIST}，无法启动代理服务，请重新运行 install.sh"
  fi
fi

# 代理服务仍未响应时给出提示
if ! curl -s --max-time 2 -o /dev/null "http://127.0.0.1:${PORT}/"; then
  echo "⚠️  本地代理 127.0.0.1:${PORT} 无响应，请检查日志："
  echo "   tail -20 ~/.codex/capacity-retry-proxy/proxy.log"
fi

echo "✅ Codex 已切换为本地重试代理模式（provider=openai-proxy，base_url=127.0.0.1:${PORT}）"
